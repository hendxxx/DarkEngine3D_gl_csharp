<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ShaderSmokeTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- glfw3.dll next to the harness exe (DllImport resolution) — copied from
         the engine build output so no new package is needed. -->
    <None Include="$(MSBuildThisFileDirectory)../../bin/Debug/net9.0/glfw3.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
