<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS0649;CS0414;CS0169;CS0219;CS8600;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625;CS8629</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Standalone tool projects (shader smoke test) must never leak into the engine build. --> 
    <DefaultItemExcludes>$(DefaultItemExcludes);Tools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Engine shaders live under the project repo path; copy them to the exe output
         folder so they load from "Artifacts/shaders/..." next to the executable
         instead of from a bin/Debug path or any absolute project path. -->
    <Content Include="Artifacts/shaders/**/*.glsl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>

    <!-- Fonts are loaded from "Artifacts/fonts/..." at runtime; copy them to the
         exe output folder too so the path is exe-relative, not project-root/etc. -->
    <Content Include="Artifacts/fonts/**/*.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

